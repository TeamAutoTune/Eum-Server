APP_NAME=Eum Backend
APP_ENV=prod
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Render Postgres example
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=sqlite:///./eum.db

# Comma-separated list
# CORS_ORIGINS=http://localhost:19006,http://127.0.0.1:19006,https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:19006,http://127.0.0.1:19006

# Optional generic LLM chat settings
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_SUMMARY_TOP_N=3

# Gemini summary settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_USE_ENV_PROXY=false

# One-time legacy onboarding backfill on deploy/startup
BACKFILL_ONBOARDING_ON_STARTUP=false
BACKFILL_ONBOARDING_USER_ID_PREFIX=
BACKFILL_ONBOARDING_TEAM_NAME_PREFIX=
BACKFILL_MATCHING_SUMMARIES_ON_STARTUP=false
BACKFILL_MATCHING_SUMMARIES_USER_ID_PREFIX=
BACKFILL_MATCHING_SUMMARIES_TEAM_NAME_PREFIX=


